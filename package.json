{
  "name": "clear-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Clear Exchange agentic workforce, operated from Telegram or WhatsApp",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "express": "5.3.0",
    "node-cron": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.19.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
