# Model provider: one of these two. With OPENROUTER_API_KEY set every agent goes through OpenRouter
# (cheap open models; see "Models through OpenRouter" in the README) and ANTHROPIC_API_KEY is ignored.
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-v1-...
# What each alias the roles use runs on in OpenRouter mode (these are the defaults):
# OPENROUTER_HAIKU_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_SONNET_MODEL=z-ai/glm-5.3
# OPENROUTER_OPUS_MODEL=moonshotai/kimi-k3.1-pro
# Prices (USD per million tokens) for any model not in src/llm.ts. They are internal: they price each
# run's own cap and stand in for the day's total only while OpenRouter's own usage cannot be read, and
# they are never shown to anyone. The daily cap uses OpenRouter's own figure (GET /api/v1/key,
# src/spend.ts), and only that figure is ever shown, so leave this unset while the default models are
# in use:
# OPENROUTER_PRICES={"qwen/qwen3.8-flash":{"input":0.15,"output":0.5,"cacheRead":0.02,"cacheWrite":0.15}}

# Channels to run at once: any of telegram, discord, whatsapp. Each conversation is answered where it came from.
CHANNELS=telegram,discord

# Telegram: message @BotFather, /newbot, paste the token. Then message your bot once; it replies
# with your id if you are not yet allowlisted. Put that id here.
TELEGRAM_BOT_TOKEN=123456789:ABC...
ALLOWED_TELEGRAM_IDS=99887766

# Discord: Developer Portal > New Application > Bot > Reset Token. Enable "Message Content Intent" on the Bot
# page. Invite it to your server with the OAuth2 URL (scope: bot; permissions: Send Messages, Create Public
# Threads, Send Messages in Threads, Read Message History). Message it once to learn your user id.
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_IDS=

# WhatsApp Cloud API (only if whatsapp is in CHANNELS; Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=EAAG...                 # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=1234567890    # the Phone number ID, not the number itself
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=                   # optional: enables X-Hub-Signature-256 verification

# Who may talk to the workforce. E.164 digits, no plus, comma separated.
ALLOWED_NUMBERS=447700900123

# Where state and outputs live (mount a volume here in production)
DATA_DIR=./data

# Files you send the bot in chat land here (default DATA_DIR/uploads), owner-only, never in a repo.
# UPLOADS_DIR=./data/uploads
UPLOAD_MAX_MB=20

# Voice notes and audio messages (Telegram, Discord, WhatsApp) are transcribed so the chief answers
# them as text. One HTTPS call to an OpenAI-compatible /audio/transcriptions endpoint; by default
# OpenRouter, whose key is already set above, so there is nothing to add. Set TRANSCRIBE_API_KEY and
# TRANSCRIBE_BASE_URL to use another provider (Groq: https://api.groq.com/openai/v1).
# TRANSCRIBE_API_KEY=                  # empty: the OPENROUTER_API_KEY above is used
# TRANSCRIBE_BASE_URL=https://openrouter.ai/api/v1
# TRANSCRIBE_MODEL=openai/whisper-large-v3
# TRANSCRIBE_MAX_MB=12                 # most audio sent for transcription
# TRANSCRIBE_MAX_SECONDS=300           # longest clip
# TRANSCRIBE_TIMEOUT_MS=60000
# TRANSCRIBE_LANGUAGE=                 # e.g. en; empty auto-detects
# TRANSCRIBE=off                       # switch transcription off entirely

# Live voice with Cleo in a Discord voice channel (src/voice.ts, src/voice-bridge.ts), all through
# OpenRouter: the transcription settings above, a fast model, and OpenRouter's text to speech.
# VOICE=off
# VOICE_MODEL=haiku                    # an alias or an OpenRouter id
# VOICE_TTS_MODEL=mistralai/voxtral-mini-tts-3-0
# VOICE_TTS_VOICE=gb_jane_neutral
# VOICE_SILENCE_MS=700                 # a pause this long ends Paul's turn
# VOICE_IDLE_MINUTES=10
# VOICE_ANSWER_WAIT_SECONDS=12


# GitHub token (fine-grained: contents and pull requests read/write on both repos). This is all
# the agents need: on first start the service clones both repositories below and configures
# git to push with this token. The gh CLI reads it too.
GH_TOKEN=github_pat_...

# The two repositories, as owner/name. The product repo is where the engineer builds Clear
# Exchange (a clean repo, with nothing from previous employers). The self repo is this workforce,
# for self-improvement.
PRODUCT_REPO=drpaulfarrow/clear-exchange
SELF_REPO=drpaulfarrow/clear-ops

# Where those clones live (created automatically)
REPO_DIR=./workspace
SELF_REPO_DIR=./self

# Other managed repositories, as alias=owner/name (optionally |another name), comma separated.
# Default: site=drpaulfarrow/drpaulfarrowcom|drpaulfarrow.com,doubleshift=shftd2-pre/app-doubleshift
# MANAGED_REPOS=site=drpaulfarrow/drpaulfarrowcom|drpaulfarrow.com,doubleshift=shftd2-pre/app-doubleshift
# REPOS_DIR=./data/repos                # default DATA_DIR/repos
# REPO_OWNER=drpaulfarrow               # account that new repositories are created under

# Optional: sign in to GitHub as a GitHub App instead of GH_TOKEN (see docs/GITHUB_APP.md).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=           # optional; found on REPO_OWNER's account when empty

# Where finished job outputs are mirrored as Markdown (must be a private repository)
# OUTPUTS_REPO=drpaulfarrow/clear-outputs

# Web search the service runs itself (any model can use it). Each tool appears only when its key is set.
# Brave: api-dashboard.search.brave.com (independent index, $5 free credit a month). Exa: dashboard.exa.ai.
# BRAVE_API_KEY=
# EXA_API_KEY=
# Retrieval as a harness decision (src/retrieval.ts): before the chief or a search-carrying worker
# answers, the service decides on the cheapest model whether a search is needed, runs it itself within
# a hard budget, and hands the results over as fenced evidence. On by default; RETRIEVAL=off turns it off.
# RETRIEVAL_MODEL is refused unless it is the cheap tier: a strong alias, the designer's or the
# assistant's role always falls back to haiku. The budget is the harness's own, never asked of a model.
# RETRIEVAL=on
# RETRIEVAL_MODEL=
# RETRIEVAL_MAX_SEARCHES=3
# RETRIEVAL_MAX_FETCHES=2
# The research-type workers' read-only browser (headless Chromium, no sign-ins, GET only). On by default.
# The browser's login vault (src/vault.ts): a long random secret, e.g. `openssl rand -base64 32`.
# Without it the vault is off. Changing it makes stored logins unreadable (add them again).
# VAULT_KEY=
# BROWSE=on
# BROWSE_MAX_ACTIONS=60

# Models (aliases accepted by the Agent SDK: fable, opus, sonnet, haiku; with OpenRouter an alias maps
# to OPENROUTER_<ALIAS>_MODEL, and a full OpenRouter id such as anthropic/claude-sonnet-4.6 also works)
CHIEF_MODEL=haiku
WORKER_MODEL=haiku
ENGINEER_MODEL=haiku
# The executive assistant reads mail and calendar. It always runs on Anthropic's API directly (keep
# ANTHROPIC_API_KEY set even with OpenRouter), on Sonnet by default. Its follow-up nudge drafts use WORKER_MODEL.
# EA_MODEL=sonnet

# A job's own spend cap, in the provider's money: the sum of what OpenRouter charged for that job's calls,
# read call by call from its own figures. Off unless set (Paul's call, 13 Nov 2026). A job is never stopped
# while it has really spent pennies, and the SDK's estimate is never used as the figure. With no
# OPENROUTER_API_KEY there is no per-call price to read and the SDK's list price is the bill, so the cap is
# handed to the SDK instead and a stop is reported as Anthropic's own list price.
# JOB_BUDGET_USD=   (per research, write, analyse and other job; off unless set)
# DEEP_RESEARCH_BUDGET_USD=   (per deep research job; off unless set)
# ENGINEER_BUDGET_USD=   (per engineer, create_agent and maintain job; off unless set)

# The Agent SDK's own per-run guard, in its rounded-up estimate (about fifty times the real charge on
# OpenRouter). Not a bill and not a job's cap: only a backstop for a run that has gone badly wrong.
SDK_RUNAWAY_BUDGET_USD=1000

# Outbound approval gate for the executive assistant: caps per London day, recipients per item,
# and how long a prepared send waits for your "send <id>"
# OUTBOUND_DAILY_CAP=10
# OUTBOUND_MAX_RECIPIENTS=10
# OUTBOUND_TTL_HOURS=24

# Job liveness: a running job whose worker shows no activity for this many minutes is stopped as
# stalled, and any job is stopped after the maximum runtime; either way its work is kept and the queue moves
JOB_STALL_MINUTES=30
JOB_MAX_RUNTIME_MINUTES=240

# Reused installs: one npm ci per repository and package-lock.json, hard-linked into each working copy
# (src/setup.ts). A store is this repository's tree, about a gigabyte, so DATA_DIR needs that much
# headroom: an install starts only when a store's size (measured on this volume, else SETUP_STORE_MB)
# plus the SETUP_MIN_FREE_MB floor is free. The npm cache is given up first, and a store built just
# before the volume fell below the floor is removed again. Bounded in total by SETUP_KEEP stores and
# by the free space the next install needs.
SETUP=on                               # off does nothing at all and leaves every worker to install for itself
# SETUP_DIR=./data/setup               # default DATA_DIR/setup; the dependency stores live in deps/ under it
SETUP_MIN_FREE_MB=512                  # the floor kept free on the volume after anything setup writes
SETUP_STORE_MB=900                     # what one store is assumed to need, until this volume has measured one
SETUP_KEEP=4                           # stores kept besides the one in use (one per managed repository), if the volume can afford them
SETUP_WAIT_MINUTES=10                  # longest a job waits for another job's install of the same lockfile
# NPM_CACHE_DIR=./data/setup/npm-cache # default SETUP_DIR/npm-cache; the shared npm cache. It is removed when
                                       # the volume falls below the floor: keep it under DATA_DIR to have it bounded

# Spend cap per Europe/London day; past it new jobs wait until /resume or tomorrow. Counted from
# OpenRouter's own usage (src/spend.ts, read at most once a minute), so it is the real bill. While that
# cannot be read it is judged on an internal stand-in figure, and /spend says so instead of showing a
# figure. The Agent SDK's price table is that stand-in and is never shown to anyone.
# DAILY_BUDGET_USD=   (off unless set; Paul's call, 13 Nov 2026)

# Design worker: the site it reviews, its browser, model and spend cap per design job
DESIGN_SITE_URL=https://clear-exchange.fly.dev
CHROMIUM_PATH=chromium
DESIGN_MODEL=haiku
# DESIGN_BUDGET_USD=   (off unless set; Paul's call, 13 Nov 2026)
# DESIGN_USER=designer                  # unprivileged account the browser runs as; never root

PORT=8080

# Executive assistant over Paul's Google Workspace ("drafts plus holds"). See README, "Executive assistant".
# Where a browser reaches this service, for the Google sign-in redirect. On Fly it defaults to https://<app>.fly.dev.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCOUNT=                        # the only account that may connect, e.g. paul@clear.exchange
EA_BOOKING_LINK=                       # optional appointment-schedule link offered in scheduling drafts
GOOGLE_TOKEN_KEY=                      # long random string; encrypts the stored refresh token

# GoDaddy DNS agent. See docs/GODADDY.md. Key and secret are production API credentials, service secrets only.
GODADDY_API_TOKEN=                      # Personal Access Token (Bearer, v3); wins over key and secret when set
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_DOMAINS=                       # comma separated allowlist; empty means clearexchange.ai,drpaulfarrow.com
DNS_TTL_HOURS=2                        # how long a prepared DNS change can be approved

# Signing you up for a site, only with your approval of each one. See docs/SIGNUP.md.
# With no SIGNUP_EMAILS, every sign-up is refused: the service never invents an address.
SIGNUP_EMAILS=                         # comma separated addresses you allow sign-ups to use
SIGNUP_SITES=                          # extra domains a sign-up may be prepared on, on top of the act list
SIGNUP_TTL_HOURS=6                     # how long a prepared sign-up waits for your approval
SIGNUP_DAILY_CAP=3                     # most sign-ups approved per London day

# Purchases (src/purchase.ts): every order approved by Paul on a one-time page or with "buy <id>".
# PURCHASE_WAIT_MINUTES=20            # how long a prepared order waits for him (at most 25)

# One-time codes (src/otp.ts): a sign-in that asks for a code the site just sent. No secret of its own:
# the service reads the code from Paul's connected mailbox (the Google connection above), or asks him in
# chat, and types it into the page itself. The code is never shown to a model, logged or stored.
# OTP_WAIT_MINUTES=10                 # how long a request waits for his own "code <id> <the code>" (at most 15)
# OTP_MAIL_WAIT_SECONDS=40            # how long the mailbox is watched for the site's own email before asking him
# OTP_MAX_PER_JOB=3                   # requests one job may make in a rolling hour
# OTP_MIN_GAP_SECONDS=20              # least gap between two requests for the same site

# Engineering jobs at once per repository, each in its own working copy (default 2, at most 8).
# Anything above 8 is refused: the extra jobs queue in order as usual.
# ENGINEER_SLOTS=2
