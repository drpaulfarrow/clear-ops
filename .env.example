# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Channels to run at once: any of telegram, discord, whatsapp. Each conversation is answered where it came from.
CHANNELS=telegram,discord

# Telegram: message @BotFather, /newbot, paste the token. Then message your bot once; it replies
# with your id if you are not yet allowlisted. Put that id here.
TELEGRAM_BOT_TOKEN=123456789:ABC...
ALLOWED_TELEGRAM_IDS=99887766

# Discord: Developer Portal > New Application > Bot > Reset Token. Enable "Message Content Intent" on the Bot
# page. Invite it to your server with the OAuth2 URL (scope: bot; permissions: Send Messages, Create Public
# Threads, Send Messages in Threads, Read Message History). Message it once to learn your user id.
DISCORD_BOT_TOKEN=
ALLOWED_DISCORD_IDS=

# WhatsApp Cloud API (only if whatsapp is in CHANNELS; Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=EAAG...                 # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=1234567890    # the Phone number ID, not the number itself
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=                   # optional: enables X-Hub-Signature-256 verification

# Who may talk to the workforce. E.164 digits, no plus, comma separated.
ALLOWED_NUMBERS=447700900123

# Where state and outputs live (mount a volume here in production)
DATA_DIR=./data

# Files you send the bot in chat land here (default DATA_DIR/uploads), owner-only, never in a repo.
# UPLOADS_DIR=./data/uploads
UPLOAD_MAX_MB=20

# GitHub token (fine-grained: contents and pull requests read/write on both repos). This is all
# the agents need: on first start the service clones both repositories below and configures
# git to push with this token. The gh CLI reads it too.
GH_TOKEN=github_pat_...

# The two repositories, as owner/name. The product repo is where the engineer builds Clear
# Exchange (a clean repo; never Atom). The self repo is this workforce, for self-improvement.
PRODUCT_REPO=drpaulfarrow/clear-exchange
SELF_REPO=drpaulfarrow/clear-ops

# Where those clones live (created automatically)
REPO_DIR=./workspace
SELF_REPO_DIR=./self

# Models (aliases accepted by the Agent SDK: fable, opus, sonnet, haiku)
CHIEF_MODEL=opus
WORKER_MODEL=sonnet
ENGINEER_MODEL=opus

# Spend caps in USD: per research/write/analyse job and chat turn, and per engineering job
JOB_BUDGET_USD=5
ENGINEER_BUDGET_USD=25

# Design worker: the site it reviews, its browser, model and spend cap per design job
DESIGN_SITE_URL=https://clear-exchange.fly.dev
CHROMIUM_PATH=chromium
DESIGN_MODEL=opus
DESIGN_BUDGET_USD=10

PORT=8080

# Executive assistant over Paul's Google Workspace ("drafts plus holds"). See README, "Executive assistant".
# Where a browser reaches this service, for the Google sign-in redirect. On Fly it defaults to https://<app>.fly.dev.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCOUNT=                        # the only account that may connect, e.g. paul@clear.exchange
EA_BOOKING_LINK=                       # optional appointment-schedule link offered in scheduling drafts
GOOGLE_TOKEN_KEY=                      # long random string; encrypts the stored refresh token
